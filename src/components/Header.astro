---
import { site } from '~/data/site';
import ThemeToggle from '~/components/ThemeToggle.astro';
---

<header class="hdr">
  <div class="hdr-inner">
    {/* Monogram only — the name is already the largest thing on the page.
        The label is for screen readers, which get no help from "RT". */}
    <a href="/" class="hdr-mark" aria-label="Home">
      <span class="hdr-initials mono">RT</span>
    </a>

    <nav class="hdr-nav" aria-label="Primary">
      {
        site.nav.map((item) => (
          <a href={item.href} class="hdr-link">
            {item.label}
          </a>
        ))
      }
    </nav>

    <ThemeToggle />
  </div>
</header>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: saturate(180%) blur(12px);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--rule);
  }

  .hdr-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gutter);
    height: 4rem;
    max-width: var(--maxw);
    margin-inline: auto;
    padding-inline: var(--margin);
  }

  .hdr-mark {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    flex-shrink: 0;
    /* Fills the header height so the hit area clears 44px on touch; the
       padding widens a two-character target that would otherwise be ~17px. */
    height: 100%;
    padding-right: 1.5rem;
  }

  .hdr-initials {
    font-size: var(--t-sm);
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--accent);
  }

  .hdr-nav {
    display: flex;
    align-items: stretch;
    height: 100%;
    gap: clamp(0.75rem, 2vw, 2rem);
    margin-left: auto;
    margin-right: clamp(0.75rem, 2vw, 2rem);
  }

  /* Links stretch to the full header height: a 44px+ hit area on touch
     without changing how the type sits. */
  .hdr-link {
    display: flex;
    align-items: center;
    font-size: var(--t-sm);
    color: var(--fg-muted);
    position: relative;
    transition: color var(--dur) var(--ease);
    white-space: nowrap;
  }

  .hdr-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 1.125rem;
    height: 1px;
    width: 0;
    background: var(--accent);
    transition: width var(--dur) var(--ease);
  }

  .hdr-link:hover,
  .hdr-link:focus-visible {
    color: var(--fg);
  }

  .hdr-link:hover::after,
  .hdr-link:focus-visible::after {
    width: 100%;
  }

  @media (max-width: 40rem) {
    /* Keeps the monogram's hit area comfortable now that it is only two
       characters wide. */
    .hdr-mark {
      padding-right: 0.75rem;
    }
    .hdr-nav {
      gap: 0.6875rem;
      margin-right: 0.375rem;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }
    .hdr-nav::-webkit-scrollbar {
      display: none;
    }
    .hdr-link {
      font-size: 0.75rem;
    }
  }

  /* Below 375px the five items genuinely cannot fit without shrinking the tap
     targets below 44px, which is not a trade worth making. Fade the trailing
     edge instead, so it reads as "scroll me" rather than "this word is cut
     off". 375px and up fits with nothing clipped. */
  @media (max-width: 23.4rem) {
    .hdr-nav {
      -webkit-mask-image: linear-gradient(to right, #000 82%, transparent 100%);
      mask-image: linear-gradient(to right, #000 82%, transparent 100%);
    }
  }
</style>
